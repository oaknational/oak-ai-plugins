{
  // The rules started as oak-open-curriculum-ecosystem's .markdownlint.json,
  // where the plugins were built until 1.1.0.
  "config": {
    "MD004": { "style": "dash" },
    "no-inline-html": false,
    "line-length": false,
    "no-duplicate-heading": { "siblings_only": true },
    "no-emphasis-as-heading": false,
    "code-block-style": false,
    "MD025": false,
    "MD026": false,
    "MD040": true,
    "MD041": false,
    "MD060": false,
    "no-alt-text": false,
    "ol-prefix": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
